<Window x:Class="SalesCopilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        Height="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="#FF0B1220"
            CornerRadius="20"
            Padding="16"
            MouseDown="Window_MouseDown">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <DockPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="LimeGreen" Margin="0,0,8,0"/>
                    <TextBlock Text="aatreus  ai"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Button Content="—"
                        Width="30"
                        Height="30"
                        DockPanel.Dock="Right"
                        Click="Compact_Click"/>
            </DockPanel>

            <!-- CHAT -->
            <ScrollViewer Grid.Row="1" Margin="0,14,0,14">
                <StackPanel x:Name="ChatPanel"/>
            </ScrollViewer>

            <!-- INPUT -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInput"
                         Height="46"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Background="#FF111827"
                         Foreground="White"
                         Padding="10"
                         BorderThickness="0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="8,0,0,0">
                    <Button Content="🎤"
                            Width="46"
                            Height="46"
                            Click="Mic_Click"/>

                    <Button Content="Send"
                            Width="70"
                            Height="46"
                            Margin="8,0,0,0"
                            Click="Send_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
